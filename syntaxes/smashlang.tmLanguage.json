{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SmashLang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#functions" },
    { "include": "#variables" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#regex" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.smashlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.smashlang",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.documentation.smashlang",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "match": "@(param|returns|return|example|description|author|version)\\s+([^\\s]*)",
              "captures": {
                "1": { "name": "storage.type.class.jsdoc" },
                "2": { "name": "variable.other.jsdoc" }
              }
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.smashlang",
          "match": "\\b(if|else|while|for|return|break|continue|switch|case|default|do|try|catch|finally|throw|import|export|from|as|of|in|instanceof|typeof|void|delete|new|class|extends|implements|interface|enum|const|let|var|function|fn|yield|await|async|this|super|static|get|set)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.smashlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.smashlang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.smashlang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.smashlang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.template.smashlang",
          "begin": "\\`",
          "end": "\\`",
          "patterns": [
            {
              "name": "constant.character.escape.smashlang",
              "match": "\\\\."
            },
            {
              "name": "entity.name.function.smashlang",
              "begin": "\\${\\{",
              "end": "\\}\\}",
              "patterns": [
                { "include": "$self" }
              ]
            },
            {
              "name": "entity.name.function.smashlang",
              "begin": "\\${",
              "end": "}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.smashlang",
          "match": "\\b(fn)\\s+([a-zA-Z_$][\\w$]*)\\s*\\(",
          "captures": {
            "1": { "name": "storage.type.function.smashlang" },
            "2": { "name": "entity.name.function.smashlang" }
          }
        },
        {
          "name": "entity.name.function.smashlang",
          "match": "\\b(function)\\s+([a-zA-Z_$][\\w$]*)\\s*\\(",
          "captures": {
            "1": { "name": "storage.type.function.smashlang" },
            "2": { "name": "entity.name.function.smashlang" }
          }
        },
        {
          "name": "support.function.smashlang",
          "match": "\\b(print|console\\.log|parseInt|parseFloat|isNaN|Math\\.[a-zA-Z]+)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.declaration.smashlang",
          "match": "\\b(const|let|var)\\s+([a-zA-Z_$][\\w$]*)\\b",
          "captures": {
            "1": { "name": "storage.type.smashlang" },
            "2": { "name": "variable.other.smashlang" }
          }
        },
        {
          "name": "variable.parameter.smashlang",
          "match": "\\b([a-zA-Z_$][\\w$]*)\\s*(?=,|\\))"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.smashlang",
          "match": "\\b(true|false|null|undefined|NaN|Infinity)\\b"
        },
        {
          "name": "constant.numeric.smashlang",
          "match": "\\b((0(x|X)[0-9a-fA-F]+)|(0(b|B)[01]+)|(0(o|O)[0-7]+)|([0-9]+(\\.[0-9]+)?((e|E)[+-]?[0-9]+)?))\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.smashlang",
          "match": "(\\+|\\-|\\*|\\/|\\%|\\^|\\&|\\||\\~|\\!|\\=|\\<|\\>|\\?|:|\\.|\\,|;)"
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.smashlang",
          "begin": "\\/(?=(?:\\\\\\/|[^\\/\\n])+\\/)",
          "end": "\\/[gimuy]*"
        }
      ]
    }
  },
  "scopeName": "source.smash"
}
